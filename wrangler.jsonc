{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caarwebsite",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caar-db",
      "database_id": "c935cca0-f944-40bc-afd0-ce627c01b83d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "8f20215dd21b4491b8670741c872e1ff"
    }
  ],
  // 每 10 分钟把 puzzle.cat 赛事快照写入 D1（用户请求只读库，不触发跨站抓取）
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
