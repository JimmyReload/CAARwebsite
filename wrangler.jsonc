{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caarwebsite",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caar-db",
      "database_id": "c935cca0-f944-40bc-afd0-ce627c01b83d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "8f20215dd21b4491b8670741c872e1ff"
    }
  ],
  // 每 10 分钟把 puzzle.cat 赛事快照写入 D1（用户请求只读库，不触发跨站抓取）
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // 日志开关（改这里或控制台变量都行，不用重新构建）
  // LOG_LEVEL：debug | info | warn | error | silent。线上用 info；排障时临时调 debug
  // AUDIT_KEEP_DAYS：审计表保留天数（Cron 定期清理，最小按 7 天算）
  "vars": {
    "LOG_LEVEL": "info",
    "AUDIT_KEEP_DAYS": "90"
  }
}
